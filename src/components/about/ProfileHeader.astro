---
import { Image } from 'astro:assets'
import profile from '../../../content/assets/about/profile.png'

export interface Props {
  name: string
}

const { name } = Astro.props
---

<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
  <Image
    src={profile}
    alt={`Portrait of ${name}`}
    width={540}
    height={720}
    loading="eager"
    class="border-accent/20 mt-0 mb-0 h-auto w-full max-w-[280px] shrink-0 rounded-sm border object-cover sm:w-52 md:w-64"
  />

  <div class="min-w-0 flex-1">
    <h1 class="mt-0 mb-0! text-3xl! sm:text-4xl!">
      {name}
    </h1>
    <slot />
  </div>
</div>
