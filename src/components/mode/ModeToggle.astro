<dark-light-toggle>
  <button
    title="Toggle dark & light mode"
    role="switch"
    class="relative flex h-7 w-15 shrink-0 cursor-pointer items-center rounded-full bg-gray-400 px-0.5 transition-colors duration-300 dark:bg-gray-600"
  >
    <span
      class="flex h-5.5 w-5.5 items-center justify-center rounded-full bg-white shadow-sm transition-transform duration-300 dark:translate-x-8.5"
    >
      <span
        aria-hidden="true"
        class="iconify tabler--sun dark:tabler--moon text-xl text-gray-700"
      ></span>
    </span>
  </button>
</dark-light-toggle>

<script>
  class DarkLightToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')

      if (!button) return

      button.setAttribute('aria-label', 'Dark mode')
      button.setAttribute('aria-checked', String(window.mode.getMode() === 'dark'))

      const handleToggle = (event: MouseEvent) => {
        const newMode = window.mode.getMode() === 'light' ? 'dark' : 'light'

        const switchMode = () => {
          window.mode.setMode(newMode)
          button.setAttribute('aria-checked', String(newMode === 'dark'))
        }

        if (!document.startViewTransition) {
          switchMode()
          return
        }

        const x = event.clientX
        const y = event.clientY
        const endRadius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        )

        document.documentElement.classList.add('theme-switching')

        const transition = document.startViewTransition(() => {
          switchMode()
        })

        transition.finished.finally(() => {
          document.documentElement.classList.remove('theme-switching')
        })

        transition.ready.then(() => {
          const duration = 600
          document.documentElement.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${endRadius}px at ${x}px ${y}px)`
              ]
            },
            {
              duration: duration,
              easing: 'cubic-bezier(.76,.32,.29,.99)',
              pseudoElement: '::view-transition-new(root)'
            }
          )
        })
      }

      button.addEventListener('click', handleToggle)
    }
  }

  if (!customElements.get('dark-light-toggle'))
    customElements.define('dark-light-toggle', DarkLightToggle)
</script>

<style is:global>
  html.theme-switching [data-astro-transition-scope] {
    view-transition-name: none !important;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-new(root) {
    z-index: 9999;
  }
  ::view-transition-old(root) {
    z-index: 1;
  }
</style>
