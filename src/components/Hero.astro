---
import Logo from '@/components/Logo.astro'

export interface Props {
  frontmatter: Partial<{
    background: boolean
    logo: boolean
  }>
}

const { background, logo: showLogo } = Astro.props.frontmatter
---

<div class="w-fit">
  <div
    class:list={[
      'text-accent relative w-fit text-xl font-bold tracking-tight sm:text-3xl',
      {
        'mb-2 pb-2 sm:mb-8': background
      }
    ]}
  >
    {background && (
      <span
        class:list={['bg-accent/30 absolute inset-0 h-full w-full blur-xl']}
      />
    )}
    <div
      class="relative flex items-center gap-1 sm:gap-1"
      transition:name="branding"
    >
      {showLogo && (
        <Logo class="h-6 w-auto shrink-0 sm:h-8" />
      )}
      <h1>
        <slot />
      </h1>
    </div>
  </div>
</div>
