---
import Pagination from '@/components/Pagination.astro'
import PageHeader from '@/components/layout/PageHeader.astro'
import ProjectsGrid from '@/components/projects/ProjectsGrid.astro'
import ProjectsList from '@/components/projects/ProjectsList.astro'
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'
import config from '@/theme.config'
import { getProjects, getProjectsPageDescription } from '@/util/projects'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'

export const getStaticPaths = (async ({ paginate }) => {
  const projects = await getProjects()

  return paginate(projects, { pageSize: config.projectsPerPage })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props

const frontmatter: PageLayoutProps['frontmatter'] = {
  title: 'Projects',
  activeHeaderLink: 'Projects'
}

const PageDescription = getProjectsPageDescription()
---

<PageLayout {frontmatter}>
  <PageHeader
    title={frontmatter.title}
    pageSuffix={page.currentPage > 1 ? ` (page ${page.currentPage})` : undefined}
  >
    {PageDescription && <PageDescription />}
  </PageHeader>

  {config.projectsView === 'list' && <ProjectsList projects={page.data} />}
  {config.projectsView === 'grid' && <ProjectsGrid projects={page.data} />}

  <Pagination slot="bottom" page={page} />
</PageLayout>
