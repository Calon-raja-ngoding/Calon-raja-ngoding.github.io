---
import Hero, { type Props as HeroProps } from '@/components/Hero.astro'
import FooterItem from '@/components/layout/FooterItem.astro'
import ModeToggle from '@/components/mode/ModeToggle.astro'
import BaseLayout, {
  type Props as BaseLayoutProps
} from '@/layouts/BaseLayout.astro'
import config from '@/theme.config'
import { getPosts } from '@/util/posts'

export type Props = BaseLayoutProps &
  HeroProps & {
    frontmatter: { showLatestPost?: boolean }
  }

const { frontmatter } = Astro.props

const latestPost = (await getPosts())[0]

// Footer gaya center (contoh: wepein.tech) — hanya di landing page.
const socialLinks = [
  { icon: 'tabler--brand-github', href: 'https://github.com/Calon-raja-ngoding', label: 'GitHub' },
  { icon: 'tabler--brand-linkedin', href: 'https://www.linkedin.com/in/nabil-hanief-mafazi-4b2204292', label: 'LinkedIn' },
  { icon: 'tabler--mail', href: 'mailto:nbilhnief@gmail.com', label: 'Email' },
  { icon: 'tabler--brand-instagram', href: 'https://www.instagram.com/bang.boksss', label: 'Instagram' }
]
const year = new Date().getFullYear()
---

<BaseLayout frontmatter={frontmatter}>
   <div class="relative flex min-h-svh flex-col">
     <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-3 pt-3">
       {frontmatter.title && (
         <div class="w-fit">
           <Hero {frontmatter}>{frontmatter.title}</Hero>
         </div>
       )}

       {config.modeToggle && (
         <div class="flex items-center text-2xl sm:text-3xl">
           <ModeToggle />
         </div>
       )}
     </div>

     <div class="mx-auto flex min-h-0 w-full max-w-[90%] flex-1 flex-col justify-center md:max-w-6xl">
       <div class="px-4 sm:px-8">
        <main id="main">
          <div
            id="animated-links"
            class="text-center text-2xl font-semibold tracking-tight text-gray-700/50 sm:text-[min(2.6vw,2.2rem)] sm:leading-[1.3] dark:text-gray-300/50"
          >
            <slot />
            {latestPost && frontmatter.showLatestPost && (
              <div class="mt-8">
                <span class="text-2xl sm:text-3xl">
                  Read my latest post{' '}
                  <a href={`/posts/${latestPost.id}/`}>{latestPost.data.title}</a>
                </span>
              </div>
            )}
          </div>
        </main>
       </div>
     </div>

     {socialLinks.length > 0 && (
       <footer class="flex shrink-0 flex-col items-center gap-4 px-4 pb-5">
         <div class="flex w-full max-w-md items-center justify-around text-2xl sm:text-3xl">
           {socialLinks.map((item) => (
             <FooterItem {item} />
           ))}
         </div>
         <p class="text-base text-gray-500 dark:text-gray-400">
           Nabil Hanief Mafazi (BangBoksss) &copy; {year} &middot; Powered by{' '}
           <a class="hover:text-accent" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
           {' '}&amp; <a class="hover:text-accent" href="https://github.com/FjellOverflow/nordlys" target="_blank" rel="noopener noreferrer">Nordlys</a>
         </p>
       </footer>
     )}
   </div>
</BaseLayout>
<style is:global>
  :root {
    overflow-y: auto !important;
  }

  #animated-links {
    a {
      color: rgb(var(--accent));

      background-image: linear-gradient(
        transparent calc(85% - 5px),
        rgba(var(--accent), 0.35) 5px
      );
      background-size: 0;
      background-repeat: no-repeat;
      display: inline;
      transition: background-size 0.5s cubic-bezier(0.65, -0.05, 0.25, 1);

      &:hover {
        background-size: 100%;
      }
    }
  }
</style>
